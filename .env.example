# ========================================================
# GraphRAG Knowledge System - Environment Configuration
# ========================================================

# Application Settings
APP_NAME=GraphRAG-Knowledge-System
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

# LLM Provider Configuration
LLM_PROVIDER=openai # openai | local | anthropic | azure
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_password
NEO4J_DATABASE=neo4j

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=graphrag_chunks
QDRANT_API_KEY=

# Document Processing & Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_EXTRACTION_WORKERS=4

# Retrieval Configuration
HYBRID_ALPHA=0.5 # 0.0 = only vector, 1.0 = only graph
TOP_K_CHUNKS=5
GRAPH_TRAVERSAL_HOPS=2
MAX_SUBGRAPH_NODES=25
